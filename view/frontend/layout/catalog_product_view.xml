<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.details">
            <block class="Octocub\ProductAttachments\Block\Product\Attachments"
                   name="octocub.product.attachments"
                   template="Octocub_ProductAttachments::product/attachments.phtml"
                   group="detailed_info">
                <arguments>
                    <argument name="title" xsi:type="string">Attachments</argument>
                    <argument name="sort_order" xsi:type="number">55</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
